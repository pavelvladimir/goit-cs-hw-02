# Run make init to create missing .env and secret files with safe permissions.
# Password values belong in the ignored secrets/ directory, never in Git.
APP_PORT=8000
LOG_LEVEL=INFO
# Total Docker stop budget; Uvicorn drains for this value minus 5 seconds (6-120).
SHUTDOWN_GRACE_SECONDS=20
DB_HOST=db
DB_PORT=5432
# Connection establishment timeout in seconds (2-30); not a SQL query timeout.
DB_CONNECT_TIMEOUT=3
DB_NAME=hw02
DB_USER=hw02_app
DB_PASSWORD_SECRET_FILE=./secrets/db_password
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password

# Local Python execution reads this file; Compose overrides it with /run/secrets/.
DB_PASSWORD_FILE=./secrets/db_password
